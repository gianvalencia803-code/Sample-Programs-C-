/******************************************************************************

THE SWITCH STATEMENT SAMPLE

Enter a number 1-3

1 - Isa  
2 - Dalawa
3 - Tatlo
default: Invalid Input

swtich then condition

break; - stops the condition before moving on the other.
         cannot break the loop

*******************************************************************************/
#include <iostream>

using namespace std;

int main()
{
    int number;
    cout << "Enter Number: ";
    cin >> number;
    
    switch(number) {
        case 1:
            cout << "Isa\n";
            break;
        case 2:
            cout << "Dalawa\n";
            break;
        case 3:
            cout << "Tatlo\n";
            break;
        default:
            cout << "Invalid Input\n";
    }
    
    cout << "Bye...\n";

    return 0;
}
