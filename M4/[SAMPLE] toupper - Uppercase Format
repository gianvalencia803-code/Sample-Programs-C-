/******************************************************************************

Letters - Uppercase Format

S - Square
R - Rectangle
C - Circle
Invalid

toupper() 

*******************************************************************************/
#include <iostream>
#include <cctype>

using namespace std;

int main()
{
    char choice;    
    
    cout <<"Menu\n";
    cout <<"S - Square\n";
    cout <<"R - Rectangle\n";
    cout <<"C - Circle\n";
    
    cout <<"Enter choice: "; // S s, R r, C C
    cin >> choice;
    
    choice = toupper (choice);
    switch(choice){
        case 'S':
            cout <<"Square\n";
            break;
        case 'R':
            cout <<"Rectangle\n";
            break;
        case 'C':
            cout <<"Circle\n";
            break;
        default:
            cout << "Inavlid\n";
    }
    
    return 0;
}
